{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "VITE_STRIPE_MODE=test npm run build",
  "outputDirectory": "build",
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
